# 学生アプリ（ResiApp）と同一の Supabase プロジェクト
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key

# サーバー専用。NEXT_PUBLIC_ は付けない。ブラウザに出さない
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key

# 学生アプリと同じ氏名復号鍵（Base64 32バイト）
# openssl rand -base64 32 で作った既存値をコピーする（新規発行すると既存氏名が読めない）
PROFILE_NAME_ENCRYPTION_KEY=
